<?xml version="1.0" encoding="utf-8"?>
<!-- Wardrobe photos are private (GUIDELINES.md §4): no cloud backup or device transfer for now. Backup comes as an
     explicit export in M2. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
