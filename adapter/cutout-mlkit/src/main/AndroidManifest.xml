<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Asks Google Play services to fetch the segmentation model when the app is installed from the Play Store.
             Sideloaded installs download it on first use instead (MlKitBackgroundRemover). -->
